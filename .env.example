# Azure OpenAI / Microsoft Foundry configuration
# Copy this file to .env and fill in your values

AZURE_OPENAI_ENDPOINT=https://your-foundry-endpoint.openai.azure.com/
AZURE_OPENAI_API_KEY=your-api-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-4.1

# Vector store ID — populated automatically by setup_vector_store.py
# or set manually if you already have a vector store
VECTOR_STORE_ID=
